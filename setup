#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
cd "$root"

if ! command -v node >/dev/null 2>&1; then
  echo 'Stocky Rescue requires Node.js 22 or newer.' >&2
  exit 1
fi

node_major="$(node -p "Number(process.versions.node.split('.')[0])")"
if [[ "$node_major" -lt 22 ]]; then
  echo 'Stocky Rescue requires Node.js 22 or newer.' >&2
  exit 1
fi

if command -v pnpm >/dev/null 2>&1; then
  package_manager=(pnpm)
elif command -v corepack >/dev/null 2>&1; then
  package_manager=(corepack pnpm)
else
  echo 'Stocky Rescue requires pnpm or Corepack to build from source.' >&2
  exit 1
fi

if [[ ! -f node_modules/fflate/package.json || ! -f node_modules/esbuild/package.json ]]; then
  CI=true "${package_manager[@]}" install --ignore-workspace --frozen-lockfile
fi
"${package_manager[@]}" build
node dist/stocky-rescue.mjs --version

echo 'Stocky Rescue is ready.'
