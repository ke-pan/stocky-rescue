{
  "name": "@shelftally/stocky-rescue",
  "version": "0.2.0",
  "description": "Local exporter and inspector for portable Stocky data-rescue archives",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./archive": {
      "types": "./src/archive-inspector.ts",
      "import": "./src/archive-inspector.ts"
    }
  },
  "packageManager": "pnpm@10.30.0",
  "bin": {
    "stocky-rescue": "dist/stocky-rescue.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "release:artifact": "pnpm run build && node scripts/package-release.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
